import random

def createmat(n):
    matrix = []
    limit = n * n * 10

    for _ in range(n):
        row = []
        for _ in range(n):
            row.append(random.randint(1, limit - 1))
        matrix.append(row)

    return matrix


def printmat(matrix, name):
    print(f"==={name}===")

    for row in matrix:
        for val in row:
            print(f"{val:>4}", end=" ")
        print()

    print()


n = int(input("input number (2~5): "))

if 1 < n <= 5:
    A = createmat(n)
    B = createmat(n)
    C = createmat(n)

    printmat(A, "Matrix A")
    printmat(B, "Matrix B")
    printmat(C, "Matrix C")

    mul_result = [[0] * n for _ in range(n)]

    for i in range(n):
        for j in range(n):
            total = 0
            for k in range(n):
                total += A[i][k] * B[k][j]
            mul_result[i][j] = total

    finalresult = []

    for i in range(n):
        row = []
        for j in range(n):
            row.append(mul_result[i][j] + C[i][j])
        finalresult.append(row)

    printmat(finalresult, "Result (A * B + C)")
